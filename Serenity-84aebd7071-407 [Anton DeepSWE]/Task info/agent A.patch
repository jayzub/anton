+public class ListRequestHandlerKeysetTests
+{
+    private static string Sql(string text) => text?.Replace("[", "").Replace("]", "").Replace("\"", "").Replace("`", "");
+
+    private static IRequestContext Context() => new NullRequestContext().WithPermissions(_ => true);
+    private static ListRequest Request(string? token = null) => new() { Take = 1, ExcludeTotalCount = true, PageToken = token };
+
+    private static async Task<(ListResponse<TRow> Response, SqlQuery Query)> Run<TRow>(bool async,
+        MockDbConnection connection, ListRequest request) where TRow : class, IRow, new()
+    {
+        if (async)
+        {
+            var handler = new ListRequestHandlerAsync<TRow>(Context());
+            return (await handler.ListAsync(connection, request, TestContext.Current.CancellationToken), handler.Query);
+        }
+        else
+        {
+            var handler = new ListRequestHandler<TRow>(Context());
+            return (handler.List(connection, request), handler.Query);
+        }
+    }
