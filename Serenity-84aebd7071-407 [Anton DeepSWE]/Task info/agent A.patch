+    [Fact]
+    public void Native_First_Page_Order_Is_Preserved_Verbatim_And_Handler_State_Is_Reset()
+    {
+        using var connection = new MockDbConnection();
+        var handler = new NativeHandler();
+        var first = handler.List(connection, Request());
+        var expected = ((ISqlQuery)handler.Query).OrderBy.ToArray();
+        Assert.Equal(new[] { "T0.Name DESC", "T0.ID DESC" }, expected.Select(Sql));
+        var second = handler.List(connection, Request(first.NextPageToken));
+        Assert.Equal(expected, ((ISqlQuery)handler.Query).OrderBy);
+        var inactive = handler.List(connection, new ListRequest());
+        Assert.Null(inactive.NextPageToken);
+        Assert.Equal(expected, ((ISqlQuery)handler.Query).OrderBy);
+        Assert.Null(((ISqlQuery)handler.Query).Where);
+        Assert.Equal(0, handler.Query.Take());
