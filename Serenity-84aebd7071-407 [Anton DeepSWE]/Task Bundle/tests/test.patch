+
+    private static MockDbDataReader ToKeysetReader(InterceptExecuteReaderArgs args, params object[] items)
+    {
+        var cols = args?.Query is ISqlQueryExtensible ext && ext.Columns.Count > 0
+            ? ext.Columns.Select(c => c.ColumnName ?? (c.IntoField as IField)?.ColumnAlias ?? c.Expression).ToArray()
+            : ["Id", "Name", "CreatedAt", "EventTime", "ExternalId", "Amount", "Score", "IsActive", "Status", "Description"];
+        if (items == null || items.Length == 0)
+            return new MockDbDataReader(cols, Enumerable.Empty<IDictionary<string, object?>>());
+        return new MockDbDataReader(cols, items);
+    }
