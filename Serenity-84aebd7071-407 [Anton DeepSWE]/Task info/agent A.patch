+    private class SeededAsyncHandler<TRow>(TRow[] rows) : ListRequestHandlerAsync<TRow>(Context()) where TRow : class, IRow, new()
+    {
+        protected override Task ExecuteQueryAsync(CancellationToken cancellationToken)
+        {
+            Response.Entities.AddRange(rows);
+            return Task.CompletedTask;
