+    public static object? ExtractBoundaryValue(Field field, IRow entity)
+    {
+        var value = field.AsObject(entity);
+        if (value is null)
+            return null;
+
+        if (!value.GetType().IsEnum)
+        {
+            var enumType = GetFieldEnumType(field);
+            if (enumType is not null)
+                return Enum.ToObject(enumType, value);
+        }
+
+        return value;
+    }
+
+    private static Type? GetFieldEnumType(Field field)
+    {
+        if (field is IEnumTypeField { EnumType.IsEnum: true } enumField)
+            return enumField.EnumType;
+
+        if (field.ValueType.IsEnum)
+            return field.ValueType;
+
+        if (Nullable.GetUnderlyingType(field.ValueType) is { IsEnum: true } underlyingEnum)
+            return underlyingEnum;
+
+        return null;
+    }
