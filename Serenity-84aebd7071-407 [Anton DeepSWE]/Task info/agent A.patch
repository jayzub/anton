+    public static IEnumerable<object[]> InvalidRequests()
+    {
+        foreach (var async in new[] { false, true })
+            foreach (var kind in new[] { "Take", "Skip", "Distinct", "EmptyDistinct", "Sort", "Criteria",
+                "Equality", "ContainsText", "ContainsField", "IncludeDeleted", "Corrupt", "Malformed", "Empty" })
+                yield return [async, kind];
+    }
+
+    [Theory]
+    [MemberData(nameof(InvalidRequests))]
+    public async Task Rejects_Invalid_Or_Replayed_Tokens(bool async, string kind)
+    {
+        using var connection = new MockDbConnection().InterceptExecuteReader(args =>
+            args.ToMockReader(new { ID = 1, Name = "A" }, new { ID = 2, Name = "B" }));
+        var first = await Run<IdNameRow>(async, connection, Request());
+        var request = Request(first.Response.NextPageToken);
+        switch (kind)
+        {
+            case "Take": request.Take = 0; break;
+            case "Skip": request.Skip = 1; break;
+            case "Distinct": request.DistinctFields = [new("Name")]; break;
+            case "EmptyDistinct": request.DistinctFields = []; break;
+            case "Sort": request.Sort = [new("Name", true)]; break;
+            case "Criteria": request.Criteria = new Criteria("ID") > 0; break;
+            case "Equality": request.EqualityFilter = new() { ["Name"] = "A" }; break;
+            case "ContainsText": request.ContainsText = "A"; break;
+            case "ContainsField": request.ContainsField = "NoSuchField"; break;
+            case "IncludeDeleted": request.IncludeDeleted = true; break;
+            case "Corrupt":
+                var token = request.PageToken!;
+                request.PageToken = token[..40] + (token[40] == 'A' ? "B" : "A") + token[41..];
+                break;
+            case "Malformed": request.PageToken = "not a token"; break;
+            case "Empty": request.PageToken = ""; break;
+        }
+        await Assert.ThrowsAsync<ValidationError>(() => Run<IdNameRow>(async, connection, request));
+        Assert.Single(connection.ExecuteReaderCalls);
+    }
