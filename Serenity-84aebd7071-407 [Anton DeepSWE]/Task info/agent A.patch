+    [Theory]
+    [MemberData(nameof(NullOrderCases))]
+    public async Task Seek_Respects_Dialect_Null_Order(string server, bool descending, bool isNull, bool async)
+    {
+        var dialect = new ISqlDialect[] { SqlServer2012Dialect.Instance, MySqlDialect.Instance,
+            SqliteDialect.Instance, PostgresDialect.Instance, OracleDialect.Instance, FirebirdDialect.Instance }
+            .Single(x => x.ServerType == server);
+        using var connection = new MockDbConnection { Dialect = dialect };
+        connection.InterceptExecuteReader(args => args.ToMockReader(
+            new { ID = 1, Name = isNull ? null : "A" }, new { ID = 2, Name = "B" }));
+        var request = Request();
+        request.Sort = [new("Name", descending)];
+        var first = await Run<IdNameRow>(async, connection, request);
+        request.PageToken = first.Response.NextPageToken;
+        var second = await Run<IdNameRow>(async, connection, request);
+        var where = Sql(((ISqlQuery)second.Query).Where!);
+        var nullsFirst = descending == (server is "Postgres" or "Oracle" or "Firebird");
+        if (isNull)
+        {
+            Assert.Equal(nullsFirst, where.Contains("T0.Name IS NOT NULL"));
+            Assert.Contains("T0.Name IS NULL", where);
+            Assert.DoesNotContain("T0.Name = @", where);
+        }
+        else
+        {
+            Assert.Equal(!nullsFirst, where.Contains("T0.Name IS NULL"));
+            Assert.Contains("T0.Name " + (descending ? "<" : ">") + " @", where);
+            Assert.Contains("T0.Name = @", where);
+            Assert.Contains("A", second.Query.Params.Values);
+        }
+        Assert.Contains("T0.ID > @", where);
+    }
