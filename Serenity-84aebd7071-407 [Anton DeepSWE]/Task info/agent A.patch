+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task Pages_Overfetch_Trim_And_Use_Last_Returned_Row(bool async)
+    {
+        using var connection = new MockDbConnection().InterceptExecuteReader(args =>
+            args.ToMockReader(new { ID = 10, Name = "same" }, new { ID = 20, Name = "same" }));
+        var first = await Run<IdNameRow>(async, connection, Request());
+        Assert.Equal(2, first.Query.Take());
+        Assert.Equal(1, first.Response.Take);
+        Assert.Equal(0, first.Response.Skip);
+        Assert.Equal(10, Assert.Single(first.Response.Entities).ID);
+        Assert.Matches("^[A-Za-z0-9_-]+$", first.Response.NextPageToken!);
+        Assert.Equal(new[] { "T0.Name", "T0.ID" }, ((ISqlQuery)first.Query).OrderBy.Select(Sql));
+
+        connection.InterceptExecuteReader(args => args.ToMockReader(new { ID = 20, Name = "same" }));
+        var second = await Run<IdNameRow>(!async, connection, Request(first.Response.NextPageToken));
+        Assert.Null(second.Response.NextPageToken);
+        Assert.Equal(20, Assert.Single(second.Response.Entities).ID);
+        Assert.Equal(1, second.Response.Take);
+        Assert.Equal(0, second.Response.Skip);
+        Assert.Contains("T0.Name > @", Sql(((ISqlQuery)second.Query).Where));
+        Assert.Contains("T0.Name = @", Sql(((ISqlQuery)second.Query).Where));
+        Assert.Contains("T0.ID > @", Sql(((ISqlQuery)second.Query).Where));
+        Assert.Contains(10, second.Query.Params.Values);
+        Assert.DoesNotContain(20, second.Query.Params.Values);
+        Assert.DoesNotContain("same", Sql(((ISqlQuery)second.Query).Where));
+
+        connection.InterceptExecuteReader(_ => new MockDbDataReader());
+        var empty = await Run<IdNameRow>(async, connection, Request(first.Response.NextPageToken));
+        Assert.Empty(empty.Response.Entities);
+        Assert.Null(empty.Response.NextPageToken);
+    }
