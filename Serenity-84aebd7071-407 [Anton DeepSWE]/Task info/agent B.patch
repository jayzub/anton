+using System.Buffers.Text;
+using System.Collections;
+using System.IO;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Serenity.Services;
+
+internal readonly record struct KeysetSortColumn(Field Field, bool Descending);
+
+internal static class KeysetPaginationHelper
+{
+    private const byte FormatVersion = 1;
+    private const int FingerprintSize = 32;
+    private const int IntegrityTagSize = 16;
+
+    private static ReadOnlySpan<byte> IntegrityDomainPrefix =>
+        "Serenity.KeysetPageToken.v1:"u8;
+
+    private static readonly UTF8Encoding StrictUtf8 = new(
+        encoderShouldEmitUTF8Identifier: false,
+        throwOnInvalidBytes: true);
+
+    private enum ValueTag : byte
+    {
+        Null = 0,
+        BoolFalse = 1,
+        BoolTrue = 2,
+        SByte = 3,
+        Byte = 4,
+        Int16 = 5,
+        UInt16 = 6,
+        Int32 = 7,
+        UInt32 = 8,
+        Int64 = 9,
+        UInt64 = 10,
+        Single = 11,
+        Double = 12,
+        Decimal = 13,
+        Char = 14,
+        StringUtf8 = 15,
+        StringUtf16 = 16,
+        Guid = 17,
+        DateTime = 18,
+        DateTimeOffset = 19,
+        DateOnly = 20,
+        TimeOnly = 21,
+        TimeSpan = 22,
+        ByteArray = 23,
+        Enum = 24
+    }
+
+    public static ValidationError InvalidTokenError(string message = "Invalid page token.") =>
+        new("InvalidPageToken", nameof(ListRequest.PageToken), message);
+
+    public static bool NullsSortFirstInAscending(ISqlDialect dialect)
+    {
+        ArgumentNullException.ThrowIfNull(dialect);
+
+        if (dialect is PostgresDialect or OracleDialect or FirebirdDialect)
+            return false;
+
+        var serverType = dialect.ServerType;
+        if (string.Equals(serverType, nameof(ServerType.Postgres), StringComparison.OrdinalIgnoreCase) ||
+            string.Equals(serverType, "PostgreSQL", StringComparison.OrdinalIgnoreCase) ||
+            string.Equals(serverType, nameof(ServerType.Oracle), StringComparison.OrdinalIgnoreCase) ||
+            string.Equals(serverType, nameof(ServerType.Firebird), StringComparison.OrdinalIgnoreCase))
+        {
+            return false;
+        }
+
+        return true;
+    }
