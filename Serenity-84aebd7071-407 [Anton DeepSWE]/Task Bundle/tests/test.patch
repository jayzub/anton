+    [Fact]
+    public void FirstPage_WithoutPageToken_PreservesSortOrderVerbatim_NoTiebreakerAdded()
+    {
+        string? capturedSql = null;
+        using var connection = CreateMockConnection()
+            .InterceptExecuteReader(args =>
+            {
+                capturedSql = args.CommandText;
+                return ToKeysetReader(args, new { Id = 1, Name = "A" }, new { Id = 2, Name = "B" }, new { Id = 3, Name = "C" });
+            });
+        var handler = new ListRequestHandler<KeysetTestRow>(Context());
+        var request = new ListRequest
+        {
+            Take = 2,
+            Skip = 0,
+            Sort = [new SortBy("Name", false)]
+        };
+
+        var response = handler.List(connection, request);
+
+        Assert.NotNull(capturedSql);
+        var orderByIndex = capturedSql.IndexOf("ORDER BY", StringComparison.OrdinalIgnoreCase);
+        Assert.True(orderByIndex >= 0);
+        var semiColonIndex = capturedSql.IndexOf(';', orderByIndex);
+        var orderByClause = semiColonIndex >= 0 ? capturedSql[orderByIndex..semiColonIndex] : capturedSql[orderByIndex..];
+        Assert.Contains("Name", orderByClause, StringComparison.OrdinalIgnoreCase);
+        var nameIdx = orderByClause.IndexOf("Name", StringComparison.OrdinalIgnoreCase);
+        var idIdx = orderByClause.IndexOf("Id", StringComparison.OrdinalIgnoreCase);
+        Assert.True(nameIdx >= 0);
+        Assert.True(idIdx > nameIdx);
+        Assert.DoesNotContain("WHERE", capturedSql, StringComparison.OrdinalIgnoreCase);
+
+        var token = GetNextPageToken(response);
+        Assert.NotNull(token);
+    }
