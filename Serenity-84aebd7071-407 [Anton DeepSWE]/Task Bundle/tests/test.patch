+    private static void SetPageToken(ListRequest request, string? token)
+    {
+        var prop = typeof(ListRequest).GetProperty("PageToken", BindingFlags.Public | BindingFlags.Instance)
+            ?? throw new Xunit.Sdk.XunitException("ListRequest does not define a public 'PageToken' property.");
+        prop.SetValue(request, token);
+    }
+
+    private static string? GetPageToken(ListRequest request)
+    {
+        var prop = typeof(ListRequest).GetProperty("PageToken", BindingFlags.Public | BindingFlags.Instance)
+            ?? throw new Xunit.Sdk.XunitException("ListRequest does not define a public 'PageToken' property.");
+        return (string?)prop.GetValue(request);
+    }
+
+    private static string? GetNextPageToken<T>(ListResponse<T> response)
+    {
+        var prop = typeof(ListResponse<T>).GetProperty("NextPageToken", BindingFlags.Public | BindingFlags.Instance)
+            ?? throw new Xunit.Sdk.XunitException("ListResponse<T> does not define a public 'NextPageToken' property.");
+        return (string?)prop.GetValue(response);
+    }
