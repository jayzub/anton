+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task Total_Count_Does_Not_Include_Seek_Filter(bool async)
+    {
+        using var connection = new MockDbConnection { Dialect = SqliteDialect.Instance };
+        connection.InterceptExecuteScalar(_ => 42).InterceptExecuteReader(args => args.ToMockReader(
+            new { ID = 1, Name = "A" }, new { ID = 2, Name = "A" }));
+        var request = Request();
+        request.ExcludeTotalCount = false;
+        request.EqualityFilter = new() { ["Name"] = "A" };
+        var first = await Run<IdNameRow>(async, connection, request);
+        request.PageToken = first.Response.NextPageToken;
+        var second = await Run<IdNameRow>(async, connection, request);
+        Assert.Equal(42, first.Response.TotalCount);
+        Assert.Equal(42, second.Response.TotalCount);
+        var countSql = Sql(connection.ExecuteScalarCalls.Last().CommandText);
+        Assert.Contains("T0.Name = @", countSql);
+        Assert.DoesNotContain("T0.ID >", countSql);
+        Assert.DoesNotContain("T0.Name >", countSql);
+        Assert.Equal(second.Query.ToString(), second.Query.Clone().ToString());
+    }
