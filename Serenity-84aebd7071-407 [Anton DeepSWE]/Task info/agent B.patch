+    public static BaseCriteria BuildSeekCriteria(
+        SqlQuery query,
+        ISqlDialect dialect,
+        ReadOnlySpan<KeysetSortColumn> effectiveSort,
+        ReadOnlySpan<object?> boundaryValues,
+        Func<Field, SqlQuery, string> getFieldExpression)
+    {
+        var nullsSortFirstInAsc = NullsSortFirstInAscending(dialect);
+        var count = effectiveSort.Length;
+        var columnClauses = new (BaseCriteria? After, BaseCriteria Equal)[count];
+
+        for (var i = 0; i < count; i++)
+        {
+            var col = effectiveSort[i];
+            var expr = getFieldExpression(col.Field, query);
+            var colCriteria = new Criteria(col.Field, expr);
+            var nullsComeFirst = nullsSortFirstInAsc != col.Descending;
+            var boundaryValue = boundaryValues[i];
+
+            if (boundaryValue is null)
+            {
+                var after = nullsComeFirst ? colCriteria.IsNotNull() : null;
+                var equal = colCriteria.IsNull();
+                columnClauses[i] = (after, equal);
+            }
+            else
+            {
+                var param = query.AutoParam();
+                query.AddParam(param.Name, boundaryValue);
+                var paramCriteria = new ParamCriteria(param.Name);
+                var cmpOp = col.Descending ? CriteriaOperator.LT : CriteriaOperator.GT;
+                var strictCmp = new BinaryCriteria(colCriteria, cmpOp, paramCriteria);
+                var after = nullsComeFirst ? strictCmp : (strictCmp | colCriteria.IsNull());
+                var equal = new BinaryCriteria(colCriteria, CriteriaOperator.EQ, paramCriteria);
+                columnClauses[i] = (after, equal);
+            }
+        }
+
+        BaseCriteria? seek = null;
+        for (var i = count - 1; i >= 0; i--)
+        {
+            var (after, equal) = columnClauses[i];
+            if (seek is null)
+                seek = after;
+            else if (after is null)
+                seek = equal & seek;
+            else
+                seek = after | (equal & seek);
+        }
+
+        return seek ?? Criteria.False;
+    }
+
+    private sealed class FingerprintCriteriaParams : IQueryWithParams
+    {
+        private int nextIndex;
+        public List<object?> Values { get; } = [];
+
+        public void AddParam(string name, object? value) => Values.Add(value);
+
+        public void SetParam(string name, object? value) => Values.Add(value);
+
+        public Parameter AutoParam() => new(nextIndex++.IndexParam());
+
+        public IDictionary<string, object?>? Params => null;
+
+        public ISqlDialect Dialect => SqlSettings.DefaultDialect;
+    }
+}
