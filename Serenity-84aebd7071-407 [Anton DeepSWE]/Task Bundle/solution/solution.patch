+                (idField.PropertyName != null && string.Equals(s.Field, idField.PropertyName, StringComparison.OrdinalIgnoreCase)));
+
+            if (!alreadyPresent)
+            {
+                list.Add(new SortBy(idPropName, false));
+            }
+        }
