+    private class KeysetPageTokenPayload
+    {
+        public string Fp { get; set; } = "";
+        public string Sig { get; set; } = "";
+        public List<KeysetValueItem> V { get; set; } = [];
+    }
+
+    private class KeysetValueItem
+    {
+        public string T { get; set; } = "";
+        public string? S { get; set; }
+        public long? L1 { get; set; }
+        public long? L2 { get; set; }
+        public double? D { get; set; }
+        public bool? B { get; set; }
+    }
+
+    private static readonly byte[] HmacSecret = [0x53, 0x65, 0x72, 0x65, 0x6E, 0x69, 0x74, 0x79, 0x4B, 0x65, 0x79, 0x73, 0x65, 0x74, 0x54, 0x6F];
+
+    /// <summary>
+    /// Generates a continuation token from the last returned entity.
+    /// </summary>
+    public virtual string GeneratePageToken(TRow entity)
+    {
+        var effectiveSort = GetEffectiveSortForKeyset();
+        var fp = ComputeRequestFingerprint(effectiveSort, Request);
+        var payload = new KeysetPageTokenPayload
+        {
+            Fp = fp,
+            V = []
+        };
+
+        foreach (var sortBy in effectiveSort)
+        {
+            var field = Row.FindField(sortBy.Field) ?? Row.FindFieldByPropertyName(sortBy.Field);
+            object? val = field is not null ? field.AsObject(entity) : null;
+            payload.V.Add(EncodeValueItem(val));
+        }
+
+        using var hmac = new HMACSHA256(HmacSecret);
+        var rawValues = JsonSerializer.Serialize(payload.V);
+        var bytesToSign = System.Text.Encoding.UTF8.GetBytes(fp + "|" + rawValues);
+        payload.Sig = Convert.ToBase64String(hmac.ComputeHash(bytesToSign));
+
+        var jsonBytes = JsonSerializer.SerializeToUtf8Bytes(payload);
+        return Convert.ToBase64String(jsonBytes).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+    }
+
+    /// <summary>
+    /// Decodes and validates a continuation token against the current request shape.
+    /// </summary>
+    public virtual object?[] DecodeAndValidatePageToken(string token, SortBy[] effectiveSort)
+    {
+        if (string.IsNullOrWhiteSpace(token))
+            throw new ValidationError("InvalidPageToken", "Continuation token cannot be empty.");
+
+        KeysetPageTokenPayload? payload;
+        try
+        {
+            string incoming = token.Replace('-', '+').Replace('_', '/');
+            switch (incoming.Length % 4)
+            {
+                case 2: incoming += "=="; break;
+                case 3: incoming += "="; break;
+            }
+            byte[] bytes = Convert.FromBase64String(incoming);
+            payload = JsonSerializer.Deserialize<KeysetPageTokenPayload>(bytes);
+        }
+        catch (Exception)
+        {
+            throw new ValidationError("InvalidPageToken", "Continuation token is malformed.");
+        }
+
+        if (payload == null || payload.V == null)
+            throw new ValidationError("InvalidPageToken", "Continuation token is invalid.");
+
+        using var hmac = new HMACSHA256(HmacSecret);
+        var rawValues = JsonSerializer.Serialize(payload.V);
+        var bytesToSign = System.Text.Encoding.UTF8.GetBytes(payload.Fp + "|" + rawValues);
+        var expectedSig = Convert.ToBase64String(hmac.ComputeHash(bytesToSign));
+        if (!string.Equals(payload.Sig, expectedSig, StringComparison.Ordinal))
+            throw new ValidationError("CorruptedPageToken", "Continuation token signature mismatch or corrupted.");
+
+        var currentFp = ComputeRequestFingerprint(effectiveSort, Request);
+        if (!string.Equals(payload.Fp, currentFp, StringComparison.Ordinal))
+            throw new ValidationError("TokenMismatch", "Continuation token was generated for a different sort order, criteria, or filter.");
+
+        var result = new object?[payload.V.Count];
+        for (int i = 0; i < payload.V.Count; i++)
+        {
+            result[i] = DecodeValueItem(payload.V[i]);
+        }
+        return result;
+    }
+
+    private static string ComputeRequestFingerprint(SortBy[] effectiveSort, ListRequest request)
+    {
+        var sb = new StringBuilder();
+        foreach (var s in effectiveSort)
+            sb.Append(s.Field).Append(':').Append(s.Descending ? "1" : "0").Append(';');
+        sb.Append('|');
+        if (request.Criteria is not null && !request.Criteria.IsEmpty)
+            sb.Append(request.Criteria.ToStringIgnoreParams());
+        sb.Append('|');
+        if (request.EqualityFilter != null && request.EqualityFilter.Count > 0)
+        {
+            foreach (var kvp in request.EqualityFilter.OrderBy(k => k.Key, StringComparer.Ordinal))
+                sb.Append(kvp.Key).Append('=').Append(kvp.Value?.ToString() ?? "null").Append(';');
+        }
+        sb.Append('|');
+        if (!string.IsNullOrEmpty(request.ContainsText))
+            sb.Append(request.ContainsText);
+        sb.Append('|');
+        if (!string.IsNullOrEmpty(request.ContainsField))
+            sb.Append(request.ContainsField);
+        sb.Append('|');
+        sb.Append(request.IncludeDeleted ? "1" : "0");
+        return sb.ToString();
+    }
+
+    private static KeysetValueItem EncodeValueItem(object? val)
+    {
+        if (val == null)
+            return new KeysetValueItem { T = "null" };
+
+        if (val is string s)
+            return new KeysetValueItem { T = "str", S = s };
+
+        if (val is bool b)
+            return new KeysetValueItem { T = "bool", B = b };
+
+        if (val is DateTime dt)
+            return new KeysetValueItem { T = "dt", L1 = dt.Ticks, S = dt.Kind.ToString() };
+
+        if (val is DateTimeOffset dto)
+            return new KeysetValueItem { T = "dto", L1 = dto.Ticks, L2 = dto.Offset.Ticks };
+
+        if (val is Guid g)
+            return new KeysetValueItem { T = "guid", S = g.ToString("D") };
+
+        if (val is decimal dec)
+            return new KeysetValueItem { T = "dec", S = dec.ToString(CultureInfo.InvariantCulture) };
+
+        if (val is double dbl)
+            return new KeysetValueItem { T = "dbl", D = dbl };
+
+        if (val is float flt)
+            return new KeysetValueItem { T = "dbl", D = (double)flt };
+
+        if (val is Enum en)
+            return new KeysetValueItem { T = "enum", L1 = Convert.ToInt64(en) };
+
+        if (val is int or long or short or byte or sbyte or uint or ulong or ushort)
+            return new KeysetValueItem { T = "int", L1 = Convert.ToInt64(val) };
+
+        return new KeysetValueItem { T = "str", S = val.ToString() };
+    }
+
+    private static object? DecodeValueItem(KeysetValueItem item)
+    {
+        return item.T switch
+        {
+            "null" => null,
+            "str" => item.S,
+            "bool" => item.B,
+            "dt" => new DateTime(item.L1!.Value, (DateTimeKind)Enum.Parse(typeof(DateTimeKind), item.S ?? "Unspecified")),
+            "dto" => new DateTimeOffset(item.L1!.Value, TimeSpan.FromTicks(item.L2!.Value)),
+            "guid" => Guid.Parse(item.S!),
+            "dec" => decimal.Parse(item.S!, CultureInfo.InvariantCulture),
+            "dbl" => item.D,
+            "int" => item.L1,
+            "enum" => item.L1.HasValue ? Convert.ToInt32(item.L1.Value) : null,
+            _ => item.S
+        };
+    }
 }
