+
+        using var conn = CreateSimulatedSqlConnection(dialect, dataset);
+        var handler = new ListRequestHandler<KeysetItemRow>(CreateContext());
+
+        bool[][] directionCombos =
+        [
+            [false, false, false],
+            [false, true, false],
+            [true, false, false],
+            [true, true, false],
+            [true, false, true]
+        ];
+
+        foreach (var dirs in directionCombos)
+        {
+            var sort = new SortBy[]
+            {
+                new(nameof(KeysetItemRow.Score), dirs[0]),
+                new(nameof(KeysetItemRow.Name), dirs[1]),
+                new(nameof(KeysetItemRow.Id), dirs[2])
+            };
+
+            var expectedOrder = dataset
+                .OrderBy(r => r, Comparer<KeysetItemRow>.Create((a, b) =>
+                {
+                    var c0 = CompareSqlValues(a.Score, b.Score, dirs[0], expectedNullsFirstInAsc);
+                    if (c0 != 0) return c0;
+                    var c1 = CompareSqlValues(a.Name, b.Name, dirs[1], expectedNullsFirstInAsc);
+                    if (c1 != 0) return c1;
+                    return CompareSqlValues(a.Id, b.Id, dirs[2], expectedNullsFirstInAsc);
+                }))
+                .Select(r => r.Id!.Value)
+                .ToList();
+
+            foreach (var take in new[] { 1, 2, 3, 5, 6, 17, 18, 25 })
+            {
+                var actualIds = new List<int>();
+                string? token = null;
+                var guard = 0;
+
+                do
+                {
+                    var resp = handler.List(conn, new ListRequest
+                    {
+                        Take = take,
+                        IncludeDeleted = true,
+                        ExcludeTotalCount = true,
+                        Sort = sort,
+                        PageToken = token
+                    });
+                    actualIds.AddRange(resp.Entities.Select(x => x.Id!.Value));
+                    token = resp.NextPageToken;
+                    Assert.True(++guard <= dataset.Count + 2, "Pagination did not terminate!");
+                }
+                while (token is not null);
+
+                Assert.Equal(expectedOrder, actualIds);
+            }
+        }
+    }
+
+    // Minimal recursive-descent evaluator over the actual emitted SQL WHERE & ORDER BY clauses
+    private static List<string> SplitTopLevelCommas(string input)
+    {
+        var list = new List<string>();
+        var depth = 0;
+        var start = 0;
+        for (var i = 0; i < input.Length; i++)
+        {
+            if (input[i] == '(') depth++;
+            else if (input[i] == ')') depth--;
+            else if (input[i] == ',' && depth == 0)
+            {
+                list.Add(input[start..i]);
+                start = i + 1;
+            }
+        }
+        list.Add(input[start..]);
+        return list;
+    }
+
+    private static string? ExtractTopLevelClause(string sql, string clauseKeyword, string[] terminators)
+    {
+        var startIdx = FindTopLevelKeyword(sql, clauseKeyword, 0);
+        if (startIdx < 0)
+            return null;
+
+        var contentStart = startIdx + clauseKeyword.Length;
+        var endIdx = sql.Length;
+        foreach (var term in terminators)
+        {
+            var idx = FindTopLevelKeyword(sql, term, contentStart);
+            if (idx >= 0 && idx < endIdx)
+                endIdx = idx;
+        }
+        return sql[contentStart..endIdx].Trim();
+    }
+
+    private static int FindTopLevelKeyword(string sql, string keyword, int fromIndex)
+    {
+        var depth = 0;
+        var inSingleQuote = false;
+        for (var i = fromIndex; i <= sql.Length - keyword.Length; i++)
+        {
+            var c = sql[i];
+            if (c == '\'')
+                inSingleQuote = !inSingleQuote;
+            else if (!inSingleQuote)
+            {
+                if (c == '(') depth++;
+                else if (c == ')') depth = Math.Max(0, depth - 1);
+                else if (depth == 0 &&
+                         (i == 0 || !char.IsLetterOrDigit(sql[i - 1])) &&
+                         string.Compare(sql, i, keyword, 0, keyword.Length, StringComparison.OrdinalIgnoreCase) == 0 &&
+                         (i + keyword.Length == sql.Length || !char.IsLetterOrDigit(sql[i + keyword.Length])))
+                {
+                    return i;
+                }
+            }
+        }
+        return -1;
+    }
+
+    private static int ParseLimitOrTop(string sql)
+    {
+        var m = Regex.Match(sql, @"\b(?:LIMIT|FIRST|FETCH\s+NEXT|TOP)\s+(\d+)\b", RegexOptions.IgnoreCase);
+        if (m.Success)
+            return int.Parse(m.Groups[1].Value, CultureInfo.InvariantCulture);
+        m = Regex.Match(sql, @"\bROWNUM\s*<=\s*(\d+)\b", RegexOptions.IgnoreCase);
+        return m.Success ? int.Parse(m.Groups[1].Value, CultureInfo.InvariantCulture) : 0;
+    }
+
+    private static object? EvaluateColumnExpr(
+        KeysetItemRow row,
+        string expr,
+        Func<KeysetItemRow, string, object?>? customExprEvaluator)
+    {
+        expr = expr.Trim();
+        if (customExprEvaluator != null && expr == "COALESCE(jLoc.Name, T0.Name)")
+            return customExprEvaluator(row, expr);
+
+        var colName = expr.StartsWith("T0.", StringComparison.OrdinalIgnoreCase) ? expr[3..] : expr;
+        colName = SqlSyntax.Unquote(colName);
+        var field = KeysetItemRow.Fields.FindField(colName)!;
+        return field.AsObject(row);
+    }
+
+    private static int CompareSqlValues(object? a, object? b, bool desc, bool nullsFirstInAsc)
+    {
+        var nullsFirst = nullsFirstInAsc != desc;
+        if (a is null && b is null) return 0;
+        if (a is null) return nullsFirst ? -1 : 1;
+        if (b is null) return nullsFirst ? 1 : -1;
+        int cmp;
+        if (a is string sa && b is string sb)
+            cmp = string.CompareOrdinal(sa, sb);
+        else
+            cmp = Comparer<object>.Default.Compare(
+                Convert.ChangeType(a, b.GetType(), CultureInfo.InvariantCulture), b);
+        return desc ? -cmp : cmp;
+    }
+
+    private static bool EvaluateSqlWhere(
+        string expr,
+        KeysetItemRow row,
+        IDictionary<string, object?> parameters,
+        Func<KeysetItemRow, string, object?>? customExprEvaluator)
+    {
+        return EvalSql3VL(expr, row, parameters, customExprEvaluator) == true;
+    }
+
+    private static bool? EvalSql3VL(
+        string expr,
+        KeysetItemRow row,
+        IDictionary<string, object?> parameters,
+        Func<KeysetItemRow, string, object?>? customExprEvaluator)
+    {
+        expr = StripOuterParens(expr.Trim());
+
+        var orPos = SplitTopLevelBinaryLogical(expr, "OR");
+        if (orPos >= 0)
+        {
+            var l = EvalSql3VL(expr[..orPos], row, parameters, customExprEvaluator);
+            var r = EvalSql3VL(expr[(orPos + 2)..], row, parameters, customExprEvaluator);
+            if (l == true || r == true) return true;
+            if (l == false && r == false) return false;
+            return null;
+        }
+
+        var andPos = SplitTopLevelBinaryLogical(expr, "AND");
+        if (andPos >= 0)
+        {
+            var l = EvalSql3VL(expr[..andPos], row, parameters, customExprEvaluator);
+            var r = EvalSql3VL(expr[(andPos + 3)..], row, parameters, customExprEvaluator);
+            if (l == false || r == false) return false;
+            if (l == true && r == true) return true;
+            return null;
+        }
+
+        if (expr.EndsWith(" IS NOT NULL", StringComparison.OrdinalIgnoreCase))
+            return ResolveAtom(expr[..^12].Trim(), row, parameters, customExprEvaluator) is not null;
+
+        if (expr.EndsWith(" IS NULL", StringComparison.OrdinalIgnoreCase))
+            return ResolveAtom(expr[..^8].Trim(), row, parameters, customExprEvaluator) is null;
+
+        foreach (var op in new[] { ">=", "<=", "!=", "<>", "=", ">", "<" })
+        {
+            var idx = FindTopLevelOperator(expr, op);
+            if (idx > 0)
+            {
+                var lv = ResolveAtom(expr[..idx].Trim(), row, parameters, customExprEvaluator);
+                var rv = ResolveAtom(expr[(idx + op.Length)..].Trim(), row, parameters, customExprEvaluator);
+                if (lv is null || rv is null)
+                    return null;
+
+                var cmp = lv is string ls && rv is string rs
+                    ? string.CompareOrdinal(ls, rs)
+                    : Convert.ToDecimal(lv, CultureInfo.InvariantCulture)
+                        .CompareTo(Convert.ToDecimal(rv, CultureInfo.InvariantCulture));
+
+                return op switch
+                {
+                    "=" => cmp == 0,
+                    "!=" or "<>" => cmp != 0,
+                    ">" => cmp > 0,
+                    ">=" => cmp >= 0,
+                    "<" => cmp < 0,
+                    "<=" => cmp <= 0,
+                    _ => throw new NotSupportedException(op)
+                };
+            }
+        }
+
+        throw new NotSupportedException("Unsupported SQL predicate: " + expr);
+    }
+
+    private static string StripOuterParens(string s)
+    {
+        while (s.Length >= 2 && s[0] == '(' && s[^1] == ')')
+        {
+            var depth = 0;
+            var wrapsAll = true;
+            for (var i = 0; i < s.Length; i++)
+            {
+                if (s[i] == '(') depth++;
+                else if (s[i] == ')') depth--;
+                if (depth == 0 && i < s.Length - 1)
+                {
+                    wrapsAll = false;
+                    break;
+                }
+            }
+            if (!wrapsAll)
+                break;
+            s = s[1..^1].Trim();
+        }
+        return s;
+    }
+
+    private static int SplitTopLevelBinaryLogical(string expr, string opKeyword)
+    {
+        var depth = 0;
+        for (var i = 0; i <= expr.Length - opKeyword.Length; i++)
+        {
+            if (expr[i] == '(') depth++;
+            else if (expr[i] == ')') depth--;
+            else if (depth == 0 &&
+                     i > 0 && char.IsWhiteSpace(expr[i - 1]) &&
+                     string.Compare(expr, i, opKeyword, 0, opKeyword.Length, StringComparison.OrdinalIgnoreCase) == 0 &&
+                     i + opKeyword.Length < expr.Length && char.IsWhiteSpace(expr[i + opKeyword.Length]))
+            {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private static int FindTopLevelOperator(string expr, string op)
+    {
+        var depth = 0;
+        for (var i = 0; i <= expr.Length - op.Length; i++)
+        {
+            if (expr[i] == '(') depth++;
+            else if (expr[i] == ')') depth--;
+            else if (depth == 0 && string.CompareOrdinal(expr, i, op, 0, op.Length) == 0)
+                return i;
+        }
+        return -1;
+    }
+
+    private static object? ResolveAtom(
+        string token,
+        KeysetItemRow row,
+        IDictionary<string, object?> parameters,
+        Func<KeysetItemRow, string, object?>? customExprEvaluator)
+    {
+        token = StripOuterParens(token);
+        if (token.StartsWith('@'))
+            return parameters[token];
+        if (int.TryParse(token, NumberStyles.Integer, CultureInfo.InvariantCulture, out var literalInt))
+            return literalInt;
+        return EvaluateColumnExpr(row, token, customExprEvaluator);
+    }
+}
