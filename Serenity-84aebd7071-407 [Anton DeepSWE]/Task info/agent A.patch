+    public static IEnumerable<object[]> NullOrderCases()
+    {
+        foreach (var dialect in new ISqlDialect[] { SqlServer2012Dialect.Instance, MySqlDialect.Instance,
+            SqliteDialect.Instance, PostgresDialect.Instance, OracleDialect.Instance, FirebirdDialect.Instance })
+            foreach (var descending in new[] { false, true })
+                foreach (var isNull in new[] { false, true })
+                    foreach (var async in new[] { false, true })
+                        yield return [dialect.ServerType, descending, isNull, async];
+    }
