+    /// <summary>
+    /// Synthesizes a dialect-aware seek filter for the effective sort and boundary tuple.
+    /// </summary>
+    public virtual BaseCriteria BuildSeekPredicate(SortBy[] sortList, object?[] values, ISqlDialect dialect)
+    {
+        string serverType = dialect.ServerType ?? "";
+        bool nullsFirst = string.Equals(serverType, "SqlServer", StringComparison.OrdinalIgnoreCase) ||
+                          string.Equals(serverType, "MySql", StringComparison.OrdinalIgnoreCase) ||
+                          string.Equals(serverType, "Sqlite", StringComparison.OrdinalIgnoreCase);
+
+        BaseCriteria totalCriteria = Criteria.Empty;
+        BaseCriteria prefixEquality = Criteria.Empty;
+
+        for (int i = 0; i < sortList.Length; i++)
+        {
+            var sortBy = sortList[i];
+            var field = Row.FindField(sortBy.Field) ?? Row.FindFieldByPropertyName(sortBy.Field);
+            if (field is null)
+                continue;
+
+            var colCriteria = ToCriteria(field);
+            var val = (i < values.Length) ? values[i] : null;
+            bool desc = sortBy.Descending;
+            bool nullsAreAfterNonNull = (nullsFirst == desc);
+
+            BaseCriteria strictlyAfter;
+
+            if (val == null)
+            {
+                if (nullsAreAfterNonNull)
+                {
+                    strictlyAfter = Criteria.Empty;
+                }
+                else
+                {
+                    strictlyAfter = colCriteria.IsNotNull();
+                }
+            }
+            else
+            {
+                BaseCriteria comp = new BinaryCriteria(colCriteria, desc ? CriteriaOperator.LT : CriteriaOperator.GT, new ValueCriteria(val));
+                if (nullsAreAfterNonNull)
+                {
+                    strictlyAfter = comp | colCriteria.IsNull();
+                }
+                else
+                {
+                    strictlyAfter = comp;
+                }
+            }
+
+            if (!strictlyAfter.IsEmpty)
+            {
+                var term = prefixEquality.IsEmpty ? strictlyAfter : (prefixEquality & strictlyAfter);
+                totalCriteria = totalCriteria.IsEmpty ? term : (totalCriteria | term);
+            }
+
+            BaseCriteria equalsCriteria;
+            if (val == null)
+                equalsCriteria = colCriteria.IsNull();
+            else
+                equalsCriteria = new BinaryCriteria(colCriteria, CriteriaOperator.EQ, new ValueCriteria(val));
+
+            prefixEquality = prefixEquality.IsEmpty ? equalsCriteria : (prefixEquality & equalsCriteria);
+        }
+
+        return totalCriteria;
+    }
