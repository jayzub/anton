+    /// <summary>
+    /// Applies keyset seek filter to the query when PageToken is set.
+    /// </summary>
+    public virtual void ApplyKeysetFilter(SqlQuery query)
+    {
+        if (!string.IsNullOrEmpty(Request.PageToken))
+        {
+            var effectiveSort = GetEffectiveSortForKeyset();
+            var values = DecodeAndValidatePageToken(Request.PageToken, effectiveSort);
+            var seekCriteria = BuildSeekPredicate(effectiveSort, values, Connection.GetDialect());
+            if (!seekCriteria.IsEmpty)
+                query.Where(~(seekCriteria));
+        }
+    }
