+    private static MockDbConnection CreateMockConnection(ISqlDialect? dialect = null)
+    {
+        var conn = new MockDbConnection();
+        if (dialect != null)
+            conn.Dialect = dialect;
+        conn.OnDbCommandExecuteScalar(_ => 10);
+        conn.InterceptExecuteScalar(_ => 10);
+        return conn;
